# Copy this file to .env.local for local development.
# No secrets belong in the frontend build — this only points the client at
# the Worker API's base URL.

# Leave empty to call same-origin /api/* (recommended for production, where
# Cloudflare Pages proxies /api/* to the Worker). Set to something like
# http://127.0.0.1:8787 when running `wrangler dev` locally on a separate port.
VITE_API_BASE_URL=
