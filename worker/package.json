{
  "name": "chantkaro-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init:local": "wrangler d1 execute chantkaro-db --local --file=./schema.sql",
    "db:migrate:local": "wrangler d1 migrations apply chantkaro-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply chantkaro-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "typescript": "~5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.28.0"
  }
}
