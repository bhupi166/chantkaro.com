# Copy to .dev.vars for local `wrangler dev`. Never commit the real file.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared secret for the two admin-only endpoints (GET /api/admin/usage,
# PATCH /api/admin/config). Pick your own long random value for local dev.
# In production this is set via `wrangler secret put ADMIN_TOKEN` instead —
# never in wrangler.toml, .dev.vars committed to git, or any frontend code.
ADMIN_TOKEN=replace-with-a-long-random-value-for-local-dev-only

# Signs/verifies short-lived session tokens (see src/session.ts). Any long
# random value works for local dev; production uses its own secret via
# `wrangler secret put SESSION_SIGNING_KEY`.
SESSION_SIGNING_KEY=replace-with-a-long-random-value-for-local-dev-only

# Cloudflare Turnstile secret key (paired with the public TURNSTILE_SITE_KEY
# in wrangler.toml). Get a test keypair from
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/ for
# local dev — production uses its own secret via
# `wrangler secret put TURNSTILE_SECRET_KEY`.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
